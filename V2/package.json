{
  "name": "bifrost-v2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @bifrost/api --filter @bifrost/web --filter @bifrost/worker dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  }
}
