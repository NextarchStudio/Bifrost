{
  "name": "@bifrost/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node --env-file-if-exists=.env --watch dist/worker.js",
    "start": "node --env-file-if-exists=.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@bifrost/database": "workspace:*",
    "@bifrost/security": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
