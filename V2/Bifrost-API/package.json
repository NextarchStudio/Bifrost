{
  "name": "@bifrost/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node --env-file-if-exists=.env --watch dist/server.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@bifrost/contracts": "workspace:*",
    "@bifrost/database": "workspace:*",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
}
